{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Team-authored evaluation cases for IT Helpdesk Agent: exactly 10 cases (5 single-turn and 5 multi-turn) covering core, advanced, and bonus capabilities.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_lookup_ticket_status",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra giúp tôi tiến độ xử lý của ticket LAB-9B1D2E4F.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_ticket_status",
            "args": {
              "ticket_id": "LAB-9B1D2E4F"
            }
          }
        ]
      },
      "metadata": {
        "skill": "bonus_tool",
        "difficulty": "medium",
        "what_it_tests": "Gọi đúng bonus tool lookup_ticket_status với ticket_id chuẩn."
      }
    },
    {
      "id": "G02_printer_howto",
      "phase": "B",
      "suite": "group",
      "query": "Tìm hướng dẫn xử lý lỗi máy in bị kẹt lệnh trên Windows.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "printing"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_printing_howto",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu hướng dẫn máy in phải dùng knowledge base."
      }
    },
    {
      "id": "G03_desktop_software_check",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra riêng phần mềm trên desktop DT-031.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "DT-031",
              "check": "software"
            }
          }
        ]
      },
      "metadata": {
        "skill": "device_software_check",
        "difficulty": "medium",
        "what_it_tests": "Trích đúng asset ID và check=software."
      }
    },
    {
      "id": "G04_external_tools_policy",
      "phase": "B",
      "suite": "group",
      "query": "Chính sách IT nói gì về việc dùng công cụ bên ngoài để xử lý dữ liệu công ty?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "policy_area": "external_tools"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_policy",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu chính sách phải dùng policy tool."
      }
    },
    {
      "id": "G05_public_driver_search",
      "phase": "B",
      "suite": "group",
      "query": "Tìm driver chính thức cho Lenovo ThinkPad T14 Gen 4.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "search_device_info",
            "args": {
              "manufacturer": "Lenovo",
              "model": "ThinkPad T14 Gen 4",
              "query_type": "drivers"
            }
          }
        ]
      },
      "metadata": {
        "skill": "external_public_search",
        "difficulty": "hard",
        "what_it_tests": "External search chỉ nhận manufacturer, model và query_type công khai."
      }
    },
    {
      "id": "G06_create_then_lookup_ticket",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Trước đó mình đã tạo ticket LAB-9B1D2E4F cho sự cố bàn phím."
        },
        {
          "role": "user",
          "content": "Tra cứu lại trạng thái của ticket LAB-9B1D2E4F đó giúp mình."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_ticket_status",
            "args": {
              "ticket_id": "LAB-9B1D2E4F"
            }
          }
        ]
      },
      "metadata": {
        "skill": "bonus_tool_multiturn",
        "difficulty": "hard",
        "what_it_tests": "Nhận diện mã ticket trong ngữ cảnh hội thoại trước để tra cứu trạng thái."
      }
    },
    {
      "id": "G07_clarify_service_then_check",
      "phase": "B",
      "suite": "group",
