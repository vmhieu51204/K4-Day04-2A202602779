          "role": "user",
          "content": "Ý mình là SSO trong production."
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "sso",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_service_clarification",
        "difficulty": "hard",
        "what_it_tests": "Dùng thông tin service và environment được bổ sung ở lượt sau."
      }
    },
    {
      "id": "G08_cancel_request",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Kiểm tra toàn bộ máy LT-240."
        },
        {
          "role": "user",
          "content": "Thôi, không cần kiểm tra nữa."
        }
      ],
      "failure_type": "unnecessary_tool",
      "expect": {
        "no_tool": true
      },
      "metadata": {
        "skill": "multiturn_cancellation",
        "difficulty": "medium",
        "what_it_tests": "Lệnh hủy mới nhất phải ngăn tool call."
      }
    },
    {
      "id": "G09_switch_kb_category",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tìm hướng dẫn xử lý sự cố máy in."
        },
        {
          "role": "user",
          "content": "Đổi ý, mình cần hướng dẫn cấp lại quyền truy cập tài khoản."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "account"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_intent_switch",
        "difficulty": "hard",
        "what_it_tests": "Ý định mới nhất thay thế yêu cầu tìm bài về máy in."
      }
    },
    {
      "id": "G10_changed_ticket_payload",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tạo ticket mức medium cho lỗi Wi-Fi trên LT-240."
        },
        {
          "role": "user",
          "content": "Đổi asset thành LT-241 và mức ưu tiên thành high."
        },
        {
          "role": "user",
          "content": "Hiển thị lại thông tin cuối cùng và hỏi xác nhận trước khi tạo."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "stale_confirmation",
        "difficulty": "hard",
        "what_it_tests": "Payload thay đổi thì phải xác nhận lại, không tự tạo ticket."
      }
